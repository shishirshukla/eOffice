<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8.1" />
  </startup>
  <appSettings>
    <!--
      Servers the signer is allowed to talk to, separated by ";".
      A signing link pointing anywhere else is refused, so a malicious
      link cannot make the token sign for someone else's server.
      Plain http:// is accepted only for servers listed here (demo use);
      production should use https:// only.
    -->
    <add key="AllowedServers" value="http://127.0.0.1:8000;http://localhost:8000" />
    <add key="RequestTimeoutSeconds" value="30" />
  </appSettings>
</configuration>
