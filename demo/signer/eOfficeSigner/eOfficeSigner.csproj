<Project Sdk="Microsoft.NET.Sdk">

  <!--
    eOffice Signer - in-house DSC signing utility.
    Targets .NET Framework 4.8.1, which is built into Windows 11, so users
    need no extra runtime. Uses only Framework assemblies (no NuGet at runtime).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net481</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>eOfficeSigner</AssemblyName>
    <RootNamespace>EOffice.Signer</RootNamespace>
    <Version>0.1.0</Version>
    <Company>Bank IT - eOffice</Company>
    <Product>eOffice Signer</Product>
    <Description>Signs eOffice documents with the user's HYP2003 DSC token.</Description>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <!-- Build-time only: lets the project compile on machines without the
       .NET Framework 4.8.1 targeting pack (e.g. build servers). Not shipped. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
